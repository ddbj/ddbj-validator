# deploy/.env のテンプレート。実際の .env は gitignore 対象にする。
# a011=本番 / a012=ステージング でこのファイルのみ差し替える。

# production / staging
DDBJ_ENV=staging

# 公開ポート（ホスト側）
DDBJ_WEB_PORT=8000

# 検証イベントの保存先（ホスト側の共有ディレクトリ。web/validator でマウント）
DDBJ_DATA_DIR_HOST=/lustre9/open/shared_data/ddbj-validator/data

# 既定の検証モード: db（内部 DB・curator/D-way） / ncbi / local
DDBJ_DEFAULT_MODE=db

# validator を別コンテナで実行する場合のみ設定（未設定なら web 内で子プロセス実行）
# DDBJ_VALIDATOR_CMD=podman exec ddbj-validator ddbj-validator

# 内部 DB 接続（common/db_manager が参照）
PGHOST=
PGPORT=
PGDATABASE=
# NCBI API
NCBI_API_KEY=
