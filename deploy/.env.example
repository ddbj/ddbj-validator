# deploy/.env のテンプレート。実際の .env は gitignore 対象にする。
# a011=本番 / a012=ステージング でこのファイルのみ差し替える。

# production / staging
DDBJ_ENV=staging

# 公開ポート（ホスト側）
DDBJ_WEB_PORT=8000

# 検証イベント(run dir)の保存先（ホスト側。container 内は /data にマウント。run_dir=<here>/<uuid[:2]>/<uuid>/）。
# a011/a012 は **ローカル NVMe /data1** に置き（高頻度 I/O）、db/env を path で区別する運用を推奨:
#   /data1/ddbj-validator/<db>/logs/<env>   例: /data1/ddbj-validator/biosample/logs/staging
# → 定期的に lustre へ rsync 同期（永続・バックアップ）: /lustre9/open/shared_data/ddbj-validator/
DDBJ_DATA_DIR_HOST=/data1/ddbj-validator/biosample/logs/staging

# 既定の検証モード: db（内部 DB・curator/D-way） / ncbi / local
DDBJ_DEFAULT_MODE=db

# 別コンテナ運用（推奨・本番）: web が validator コンテナを podman exec で呼ぶ。
# validator を頻繁に更新しても web を止めずに入れ替えられる（無停止）。
# 有効化するには下記 2 つを設定し、compose の web volumes の socket 行のコメントを外す（README 参照）。
# 空にすると単一コンテナ運用（web 内で validator を子プロセス実行・開発/簡易向け）。
# DDBJ_VALIDATOR_CMD=podman exec ddbj-validator ddbj-validator
# host の rootless podman socket パス（`podman info --format '{{.Host.RemoteSocket.Path}}'` で確認）
# DDBJ_PODMAN_SOCK=/run/user/1000/podman/podman.sock

# 内部 DB 接続（common/db_manager が参照）
PGHOST=
PGPORT=
PGDATABASE=
# NCBI API
NCBI_API_KEY=
