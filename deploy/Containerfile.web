# web コンテナ（FastAPI + uvicorn）。UUID 発行・run dir 作成・status/log 管理・validator 呼び出し。
FROM python:3.11-slim

# 別コンテナ運用: web が validator コンテナへ `podman exec` するための podman クライアント。
# CONTAINER_HOST（compose で設定）経由でホストの rootless podman socket をリモート操作する。
# コード変更でキャッシュが無効化されないよう COPY より前の層で入れる。
RUN apt-get update \
    && apt-get install -y --no-install-recommends podman \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app

# web extra（fastapi / uvicorn / python-multipart）込みでインストール。
RUN pip install --no-cache-dir ".[web]"

# 実行ユーザは container root のまま（USER は指定しない）。
# rootless podman では container root = ホストの w3const（非特権）で、ホスト権限は増えない。
# validator コンテナも container root で動くため、共有ボリューム /data 上のファイル所有者が
# 両コンテナで一致する。以前は `USER web`(uid1000) にしていたが、host 上では subuid
# （223300999 等）になり validator が作ったファイル（w3const 所有）を書けず、
# run dir 作成が確率的に PermissionError → POST /validation が 500 になっていた。
# 転送された rootless podman socket（コンテナ内では root:root 0660）も所有者一致で扱えるため、
# 以前必要だった `useradd -G root web` の group 0 ハックも不要になった。

# 稼働中コードの commit を焼き込む（GET /definitions の `commit`）。.dockerignore で .git を
# 除いており、イメージ内では git から取れないため。compose.sh が `git rev-parse --short HEAD` を
# build arg で渡す。未指定なら空で、登録システム側は version だけで運用する。
ARG DDBJ_COMMIT=""
ENV DDBJ_COMMIT=${DDBJ_COMMIT}

EXPOSE 8000

# 既定は同一イメージ内の validator を子プロセス起動（DDBJ_VALIDATOR_CMD 未設定時）。
# 別コンテナ運用では compose 側で DDBJ_VALIDATOR_CMD を `podman exec ...` に設定する。
CMD ["uvicorn", "apps.webapi.app:app", "--host", "0.0.0.0", "--port", "8000"]
