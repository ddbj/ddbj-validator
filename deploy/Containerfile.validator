# validator コンテナ（検証エンジン）。UUID/イベントは持たない。
# 既存 CLI（main.py: ddbj/biosample/bioproject/dra/gea/metabobank）をそのまま提供する。
FROM python:3.11-slim

WORKDIR /app
COPY . /app

# record extra = DDBJ Record 入力のスキーマ検証 (BS_R0098)。入れないと黙って検証されない。
RUN pip install --no-cache-dir ".[record]" \
    && useradd -m runner
USER runner

# web からは共有ボリューム上の run dir を -o に渡して呼ばれる。
ENTRYPOINT ["ddbj-validator"]
